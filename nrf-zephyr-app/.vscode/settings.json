{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "ms-vscode.cpptools",

  "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

  // If you are trying to format C/C++ files and have the Prettier C++ plugin:
  "[c]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  // For Zephyr configuration files
  "[properties]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "ms-vscode.cpptools"
  }
}
