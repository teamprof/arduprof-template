{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start OpenOCD",
      "type": "shell",
      "command": "${env:HOME}/.espressif/tools/openocd-esp32/v0.12.0-esp32-20251215/openocd-esp32/bin/openocd",
      "args": [
        "-f",
        "board/esp32s3-builtin.cfg"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Open On-Chip Debugger",
          "endsPattern": "Listening on port 3333 for gdb connections"
        }
      }
    }
  ]
}
